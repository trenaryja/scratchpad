{
	"name": "@trenaryja/scratchpad",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "concurrently \"next dev --turbo\" \"convex dev\"",
		"build": "next build",
		"start": "next start",
		"fix": "prettier -w . '!convex/_generated/**' && eslint --fix .",
		"check": "rm -rf .next && tsc && prettier -c . '!convex/_generated/**' && eslint . && bun run build",
		"get-latest": "bun update --latest --interactive",
		"reinstall": "rm -rf node_modules bun.lock && bun install",
		"env:pull": "infisical export > .env.local"
	},
	"dependencies": {
		"@mantine/hooks": "^9.5.1",
		"@monaco-editor/react": "^4.7.0",
		"@trenaryja/ui": "0.0.1-35",
		"convex": "^1.44.0",
		"daisyui": "^5.7.17",
		"date-fns": "4.1.0",
		"nanoid": "^6.0.1",
		"next": "16.3.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-icons": "^5.7.0",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"remeda": "^2.40.0",
		"yjs": "^13.6.32"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@testing-library/dom": "^10.4.1",
		"@trenaryja/config": "^0.0.1",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"concurrently": "^10.0.5",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0"
	},
	"postcss": {
		"plugins": {
			"@tailwindcss/postcss": {}
		}
	},
	"prettier": "@trenaryja/config/prettier",
	"trustedDependencies": [
		"esbuild",
		"sharp",
		"unrs-resolver"
	]
}
